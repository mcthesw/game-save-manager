{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RGSM",
  "identifier": "com.game-save-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm web:tauri-dev",
    "beforeBuildCommand": "pnpm web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Game Save Manager",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1OUQzMjMzODc3ODNBMApSV1NnZzNjNEk5TlpCMENGNGFvSTEzVjhCam50bnNMRndsTGs0aDlyUnJWVGxpanZadi9rZjV2MQo=",
      "endpoints": [
        "https://github.com/mcthesw/game-save-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
