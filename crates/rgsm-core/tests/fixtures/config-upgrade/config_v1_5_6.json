{
  "version": "1.5.6",
  "backup_path": "save_data",
  "games": [
    {
      "name": "Cross Device Quest",
      "save_paths": [
        {
          "unit_type": "Folder",
          "paths": {
            "desktop-alpha": "C:/Users/Player/Documents/My Games/Cross Device Quest/Saves",
            "deck-beta": "/home/deck/.local/share/Cross Device Quest/Saves"
          },
          "delete_before_apply": true
        },
        {
          "unit_type": "File",
          "paths": {
            "desktop-alpha": "C:/Users/Player/AppData/Local/CDQ/settings.json",
            "deck-beta": "/home/deck/.config/cdq/settings.json"
          },
          "delete_before_apply": false
        }
      ],
      "game_paths": {
        "desktop-alpha": "D:/Games/Cross Device Quest/game.exe",
        "deck-beta": "/home/deck/Games/cross-device-quest/game"
      }
    }
  ],
  "settings": {
    "prompt_when_not_described": true,
    "extra_backup_when_apply": true,
    "show_edit_button": true,
    "prompt_when_auto_backup": false,
    "exit_to_tray": true,
    "cloud_settings": {
      "auto_sync_interval": 15,
      "root_path": "/rgsm-fixtures",
      "backend": { "type": "Disabled" },
      "always_sync": true
    },
    "locale": "en_US",
    "default_delete_before_apply": false,
    "default_expend_favorites_tree": false,
    "home_page": "/",
    "log_to_file": true,
    "add_new_to_favorites": true,
    "save_list_expand_behavior": "remember_last",
    "save_list_last_expanded": true,
    "max_auto_backup_count": 7
  },
  "favorites": [
    {
      "node_id": "game-cross-device-quest",
      "label": "Cross Device Quest",
      "is_leaf": true,
      "children": null
    }
  ],
  "quick_action": {
    "quick_action_game": {
      "name": "Cross Device Quest",
      "save_paths": [],
      "game_paths": {}
    },
    "hotkeys": {
      "apply": ["Control", "Shift", "F5"],
      "backup": ["Control", "Shift", "F6"]
    },
    "enable_sound": false,
    "enable_notification": true,
    "sounds": {
      "success": { "kind": "default" },
      "failure": { "kind": "default" }
    }
  },
  "devices": {
    "desktop-alpha": {
      "id": "desktop-alpha",
      "name": "Windows Desktop"
    },
    "deck-beta": {
      "id": "deck-beta",
      "name": "Linux Handheld"
    }
  }
}
